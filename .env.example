# Bidar — environment configuration
#
# Copy this file to .env, fill in real values, then run:
#   docker compose up -d
# (docker compose reads .env automatically; .env is gitignored.)
#
# Every BIDAR_* variable below is defined in internal/envconfig — the
# single source of truth for env var names. Do not rename a variable here
# without updating that package first.

# --- Daemon (BIDAR_*) ---

# Postgres connection string.
# docker-compose.yml sets this automatically from the POSTGRES_* variables
# below (pointing at the postgres service inside the compose network), so
# the value here is only used if you override it to reach an external
# database. Keep it in sync with POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB
# if you do.
BIDAR_DATABASE_URL=postgres://bidar:bidar@postgres:5432/bidar

# WARNING: this value is a PLACEHOLDER. It is deliberately NOT valid
# base64, so the daemon will refuse to start until you replace it — but
# never ship this in production, and never commit a real key.
# Generate a real 32-byte key before deploying:
#   openssl rand -base64 32
BIDAR_MASTER_KEY=CHANGE_ME_generate_with_openssl_rand_-base64_32

# Daemon log level: debug | info | warn | error (default: info)
BIDAR_LOG_LEVEL=info

# Provider cadences (Go durations; defaults shown)
BIDAR_AD_INTERVAL=24h
BIDAR_ARP_INTERVAL=5m
BIDAR_DHCP_INTERVAL=5m
BIDAR_ICMP_INTERVAL=5m

# Max age of Windows DHCP lease-export files before the collector
# refuses them (stale = failed source, never silently fresh)
BIDAR_DHCP_STALENESS=24h

# DHCP lease-export share, mounted read-only at /mnt/dhcp inside the
# daemon container. On Windows (Docker Desktop) use a UNC path like
# //dc01/dhcp$ or a mapped drive letter; on Linux any host path. Point
# dhcp-sources set-path at /mnt/dhcp/<file> inside the container.
DHCP_SHARE_SRC=./dhcp

# --- Postgres (compose-level; consumed by docker-compose.yml, not the
# --- bidar binary itself) ---

POSTGRES_USER=bidar
# WARNING: placeholder. Use a real, strong password in production.
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=bidar
